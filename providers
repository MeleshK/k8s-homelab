terraform {
  required_providers {
    proxmox = {
      source  = "bpg/proxmox"
      version = "~> 0.73"
    }
  }
}

provider "proxmox" {
  endpoint = https://10.0.0.11:8006   # e.g. "https://10.0.0.2:8006/"
  username = "root@pam"      # e.g. "root@pam"
  password = ""
  insecure = true                  # self-signed cert on homelab
}