#cloud-config
hostname: k8s-control-plane
manage_etc_hosts: true
package_update: true
package_upgrade: false

users:
  - name: rocky
    ssh_authorized_keys:
      - ${ssh_public_key}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash

write_files:
  - path: /etc/modules-load.d/k8s.conf
    content: |
      overlay
      br_netfilter
  - path: /etc/sysctl.d/k8s.conf
    content: |
      net.bridge.bridge-nf-call-iptables  = 1
      net.bridge.bridge-nf-call-ip6tables = 1
      net.ipv4.ip_forward                 = 1
  - path: /tmp/calico-installation.yaml
    content: |
      apiVersion: operator.tigera.io/v1
      kind: Installation
      metadata:
        name: default
      spec:
        calicoNetwork:
          ipPools:
          - blockSize: 26
            cidr: ${pod_cidr}
            encapsulation: VXLANCrossSubnet
            natOutgoing: Enabled
            nodeSelector: all()
      ---
      apiVersion: operator.tigera.io/v1
      kind: APIServer
      metadata:
        name: default
      spec: {}

chpasswd:
  list: |
    rocky:${vm_password}
  expire: false

runcmd:
  - modprobe overlay
  - modprobe br_netfilter
  - sysctl --system

  # Disable swap
  - swapoff -a
  - sed -i '/swap/d' /etc/fstab

  # SELinux — set permissive (kubeadm requirement)
  - setenforce 0
  - sed -i 's/^SELINUX=enforcing$/SELINUX=permissive/' /etc/selinux/config

  # containerd
  - dnf config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo
  - dnf install -y containerd.io
  - containerd config default > /etc/containerd/config.toml
  - sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
  - systemctl restart containerd
  - systemctl enable containerd

  # kubeadm / kubelet / kubectl
  - |
    cat <<EOF > /etc/yum.repos.d/kubernetes.repo
    [kubernetes]
    name=Kubernetes
    baseurl=https://pkgs.k8s.io/core:/stable:/v${k8s_version}/rpm/
    enabled=1
    gpgcheck=1
    gpgkey=https://pkgs.k8s.io/core:/stable:/v${k8s_version}/rpm/repodata/repomd.xml.key
    EOF
  - dnf install -y kubelet kubeadm kubectl --disableexcludes=kubernetes
  - systemctl enable --now kubelet

  # Init control plane
  - kubeadm init --pod-network-cidr=${pod_cidr} --apiserver-advertise-address=${control_plane_ip} 2>&1 | tee /var/log/kubeadm-init.log

  # kubeconfig for rocky user
  - mkdir -p /home/rocky/.kube
  - cp /etc/kubernetes/admin.conf /home/rocky/.kube/config
  - chown rocky:rocky /home/rocky/.kube/config

  # Calico CNI via Tigera operator
  - sudo -u rocky kubectl create -f https://raw.githubusercontent.com/projectcalico/calico/v3.29.0/manifests/tigera-operator.yaml
  - sudo -u rocky kubectl apply -f /tmp/calico-installation.yaml

  # Save join command for workers
  - kubeadm token create --print-join-command > /tmp/kubeadm-join.sh
  - chmod +x /tmp/kubeadm-join.sh
